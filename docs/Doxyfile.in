PROJECT_NAME           = Anima
PROJECT_BRIEF          = "Reusable native game runtime"
OUTPUT_DIRECTORY       = "@ANIMA_DOCUMENTATION_OUTPUT@"
INPUT                  = "@ANIMA_DOCUMENTATION_SOURCE@/include/anima" \
                         "@ANIMA_DOCUMENTATION_SOURCE@/docs/api/index.md"
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE  = "@ANIMA_DOCUMENTATION_SOURCE@/docs/api/index.md"
STRIP_FROM_PATH        = "@ANIMA_DOCUMENTATION_SOURCE@/include"
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXCLUDE_SYMBOLS        = anima::detail anima::detail::*
INTERNAL_DOCS          = NO
HIDE_IN_BODY_DOCS      = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
VERBATIM_HEADERS       = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
