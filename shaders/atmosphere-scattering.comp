#version 450
#extension GL_GOOGLE_include_directive : require
// The multiple scattering table of Hillaire's section 5.5: for each altitude and sun zenith cosine, the light that
// scatters more than once, Psi_ms = L_2 / (1 - f_ms), per unit of sunlight. L_2 is the light that reaches the point
// after scattering once on its way, and f_ms the share of light scattered toward the point that the media transfer,
// both through an isotropic phase function and averaged over the directions from the point, which the
// ANIMA_SCATTERING_INVOCATIONS invocations of the workgroup that a texel dispatches share. Each texel stores the term's
// logarithm (multipleScattering() in atmosphere.glsl).
#include "shader_interface.h"
// The sums below halve the invocations, and each band of directions takes two of them on each side of the horizon.
#if ANIMA_SCATTERING_INVOCATIONS < 4 || (ANIMA_SCATTERING_INVOCATIONS & (ANIMA_SCATTERING_INVOCATIONS - 1)) != 0
#error ANIMA_SCATTERING_INVOCATIONS must be a power of two of at least 4
#endif
layout(local_size_x = ANIMA_SCATTERING_INVOCATIONS) in;
#include "environment_data.glsl"
#include "atmosphere.glsl"
layout(set = ANIMA_SET_ATMOSPHERE, binding = ANIMA_ATMOSPHERE_WRITE_MULTIPLE_SCATTERING,
       rgba16f) uniform writeonly image2D multipleScatteringTable;
layout(set = ANIMA_SET_ATMOSPHERE, binding = ANIMA_ATMOSPHERE_READ_TRANSMITTANCE) uniform sampler2D transmittanceTable;

shared vec3 secondOrder[ANIMA_SCATTERING_INVOCATIONS];
shared vec3 transfer[ANIMA_SCATTERING_INVOCATIONS];

void main() {
    ivec2 texel = ivec2(gl_WorkGroupID.xy);
    vec2 uv = (vec2(texel) + 0.5) / vec2(multipleScatteringSize);
    float sunMu = unitFromTexture(uv.x, multipleScatteringSize.x) * 2.0 - 1.0;
    float altitude = clamp(unitFromTexture(uv.y, multipleScatteringSize.y) * thickness(), 1.0, thickness() - 1.0);
    vec3 sun = vec3(sqrt(max(1.0 - sunMu * sunMu, 0.0)), sunMu, 0.0);
    const float isotropic = 1.0 / (4.0 * PI);
    const int steps = 20;
    // Two directions per invocation: bands of the zenith cosine, half above the point's horizon and half below it,
    // crowded toward it by the square of their index, where the light of a low or set sun arrives along paths that
    // graze the sunlit air; and in each band, azimuths on the side of the sun's vertical plane, each standing for
    // itself and its mirror image across that plane, which sees the same light. A band's perBand invocations take its
    // azimuths in turn. Each direction weighs its band's width in zenith cosine over the sphere's 2, over the azimuths.
    // With 64 invocations, that is 128 directions in 32 bands, 16 on each side.
    const uint azimuths = 4u, perBand = azimuths / 2u, bandsPerSide = uint(ANIMA_SCATTERING_INVOCATIONS) / perBand / 2u;
    uint index = gl_LocalInvocationIndex, band = index / perBand, side = band / bandsPerSide;
    float horizon = -sqrt(altitude * (2.0 * groundRadius() + altitude)) / (groundRadius() + altitude);
    float below = float(band % bandsPerSide) / float(bandsPerSide), above = below + 1.0 / float(bandsPerSide),
          middle = 0.5 * (below + above);
    float extent = side == 0u ? 1.0 - horizon : 1.0 + horizon;
    float mu = horizon + (side == 0u ? 1.0 : -1.0) * extent * middle * middle;
    float share = extent * (above * above - below * below) / (2.0 * float(azimuths));
    bool ground = meetsGround(altitude, mu);
    float span = pathLength(altitude, mu), across = sqrt(max(1.0 - mu * mu, 0.0));
    vec3 light = vec3(0.0), transferred = vec3(0.0);
    for (uint slot = index % perBand; slot < azimuths; slot += perBand) {
        float azimuth = PI * (float(slot) + 0.5) / float(azimuths);
        float along = dot(vec3(across * cos(azimuth), mu, across * sin(azimuth)), sun);
        vec3 throughput = vec3(1.0);
        for (int i = 0; i < steps; ++i) {
            // Steps that grow with the square of their index, finer near the point.
            float t, dt;
            squaredStep(i, steps, span, t, dt);
            float height = altitudeAlong(altitude, mu, t);
            vec3 extinction = extinctionAt(height);
            vec3 scattering = rayleighScatteringAt(height) + mieScatteringAt(height);
            float sunMuThere = zenithCosineAlong(altitude, mu, t, sunMu, along);
            vec3 source = scattering * transmittanceToTop(transmittanceTable, height, sunMuThere) * isotropic;
            vec3 step = exp(-extinction * dt);
            vec3 weight = stepIntegral(extinction, step, dt);
            light += share * throughput * source * weight;
            transferred += share * throughput * scattering * weight;
            throughput *= step;
        }
        if (ground) {
            float sunMuGround = zenithCosineAlong(altitude, mu, span, sunMu, along);
            light += share * throughput * environment.atmosphereGround.rgb / PI *
                     transmittanceToTop(transmittanceTable, 0.0, sunMuGround) * max(sunMuGround, 0.0);
        }
    }
    // The averages over the sphere: of the light scattered once toward the point through the isotropic phase, and of
    // the scattering that the paths transfer, which the isotropic phase over the whole sphere passes on whole.
    secondOrder[index] = light;
    transfer[index] = transferred;
    barrier();
    for (uint stride = uint(ANIMA_SCATTERING_INVOCATIONS) / 2u; stride > 0u; stride >>= 1u) {
        if (index < stride) {
            secondOrder[index] += secondOrder[index + stride];
            transfer[index] += transfer[index + stride];
        }
        barrier();
    }
    if (index == 0u) {
        // A geometric series of further scattering, capped so that a dense atmosphere stays finite.
        vec3 series = 1.0 / (1.0 - min(transfer[0], vec3(0.99)));
        imageStore(multipleScatteringTable, texel,
                   vec4(log(max(secondOrder[0] * series, vec3(leastMultipleScattering))), 1.0));
    }
}
