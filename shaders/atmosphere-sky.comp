#version 450
#extension GL_GOOGLE_include_directive : require
// The sky view table: the sky's radiance per unit of the sun's irradiance above the atmosphere, for each direction seen
// from the altitude in atmosphereGround.w (skyViewCoordinates()), which the renderer holds while the eye's altitude
// stays within a tolerance of it, marched to the atmosphere's top or to the ground, where the ground's albedo reflects
// the transmitted sun. Each step adds the light that the medium scatters toward the eye, once from the sun through the
// Rayleigh and Mie phase functions and many times through the multiple scattering table, integrated over the step
// against the step's own extinction.
layout(local_size_x = 8, local_size_y = 8) in;
#include "environment_data.glsl"
#include "atmosphere.glsl"
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D skyViewTable;
layout(set = 0, binding = 3) uniform sampler2D transmittanceTable;
layout(set = 0, binding = 4) uniform sampler2D multipleScatteringTable;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, skyViewSize)))
        return;
    vec2 uv = (vec2(texel) + 0.5) / vec2(skyViewSize);
    float altitude = environment.atmosphereGround.w;
    // Invert skyViewCoordinates().
    float azimuth = atmospherePi * pow(unitFromTexture(uv.x, skyViewSize.x), 2.0);
    float v = unitFromTexture(uv.y, skyViewSize.y), dip = horizonDip(altitude), elevation;
    if (v >= 0.5)
        elevation = -dip + pow(2.0 * v - 1.0, 2.0) * (0.5 * atmospherePi + dip);
    else
        elevation = -dip - pow(1.0 - 2.0 * v, 2.0) * (0.5 * atmospherePi - dip);
    // In a frame whose horizontal axis x points toward the sun's azimuth.
    float sunMu = environment.sunDirection.y;
    vec3 sun = vec3(sqrt(max(1.0 - sunMu * sunMu, 0.0)), sunMu, 0.0);
    vec3 direction = vec3(cos(elevation) * cos(azimuth), sin(elevation), cos(elevation) * sin(azimuth));
    float mu = direction.y, along = dot(direction, sun);
    float rayleighPhaseValue = rayleighPhase(along), miePhaseValue = miePhase(along);
    bool ground = meetsGround(altitude, mu);
    float span = pathLength(altitude, mu);
    const int steps = 30;
    vec3 throughput = vec3(1.0), light = vec3(0.0);
    for (int i = 0; i < steps; ++i) {
        // Steps that grow with the square of their index, finer near the eye.
        float near = span * pow(float(i) / float(steps), 2.0), far = span * pow(float(i + 1) / float(steps), 2.0);
        float t = 0.5 * (near + far), dt = far - near;
        float height = altitudeAlong(altitude, mu, t);
        vec3 extinction = extinctionAt(height);
        vec3 rayleigh = rayleighScatteringAt(height), mie = mieScatteringAt(height);
        float sunMuThere = zenithCosineAlong(altitude, mu, t, sunMu, along);
        vec3 source = (rayleigh * rayleighPhaseValue + mie * miePhaseValue) *
                          transmittanceToTop(transmittanceTable, height, sunMuThere) +
                      (rayleigh + mie) * multipleScattering(multipleScatteringTable, height, sunMuThere);
        vec3 step = exp(-extinction * dt);
        vec3 weight = mix((1.0 - step) / max(extinction, vec3(1e-20)), vec3(dt), lessThan(extinction, vec3(1e-20)));
        light += throughput * source * weight;
        throughput *= step;
    }
    if (ground) {
        float sunMuGround = zenithCosineAlong(altitude, mu, span, sunMu, along);
        light += throughput * environment.atmosphereGround.rgb / atmospherePi *
                 transmittanceToTop(transmittanceTable, 0.0, sunMuGround) * max(sunMuGround, 0.0);
    }
    // Kept within half precision, whose overflow to infinity would turn filtering's zero weights into NaN.
    imageStore(skyViewTable, texel, vec4(min(light, vec3(65504.0)), 1.0));
}
