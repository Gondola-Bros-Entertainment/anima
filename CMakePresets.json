{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ANIMA_WARNINGS_AS_ERRORS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "core",
      "displayName": "Core only (macOS / Windows / Linux, no graphics or asset dependencies)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": { "ANIMA_BUILD_DESKTOP": false, "ANIMA_BUILD_ASSETS": false }
    },
    {
      "name": "headless",
      "displayName": "Headless core and GLB importer (macOS / Windows / Linux)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": { "ANIMA_BUILD_DESKTOP": false, "ANIMA_BUILD_ASSETS": true }
    },
    {
      "name": "desktop",
      "displayName": "SDL3 / Vulkan viewer (macOS / Windows / Linux)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": { "ANIMA_BUILD_DESKTOP": true, "ANIMA_BUILD_ASSETS": true, "ANIMA_BUILD_AUDIO_OUTPUT": true }
    },
    {
      "name": "full",
      "displayName": "Every module: desktop, UI, physics, 2D physics, SDL input and audio output",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/full",
      "cacheVariables": {
        "ANIMA_BUILD_DESKTOP": true,
        "ANIMA_BUILD_ASSETS": true,
        "ANIMA_BUILD_UI": true,
        "ANIMA_BUILD_UI_DOCUMENTS": true,
        "ANIMA_BUILD_PHYSICS": true,
        "ANIMA_BUILD_PHYSICS2D": true,
        "ANIMA_BUILD_INPUT_SDL": true,
        "ANIMA_BUILD_AUDIO_OUTPUT": true
      }
    }
  ],
  "buildPresets": [
    { "name": "core", "configurePreset": "core" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "full", "configurePreset": "full" }
  ],
  "testPresets": [
    {
      "name": "defaults",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "core", "inherits": "defaults", "configurePreset": "core" },
    { "name": "headless", "inherits": "defaults", "configurePreset": "headless" },
    { "name": "desktop", "inherits": "defaults", "configurePreset": "desktop" },
    { "name": "full", "inherits": "defaults", "configurePreset": "full" }
  ],
  "workflowPresets": [
    {
      "name": "core",
      "steps": [
        { "type": "configure", "name": "core" },
        { "type": "build", "name": "core" },
        { "type": "test", "name": "core" }
      ]
    },
    {
      "name": "headless",
      "steps": [
        { "type": "configure", "name": "headless" },
        { "type": "build", "name": "headless" },
        { "type": "test", "name": "headless" }
      ]
    },
    {
      "name": "desktop",
      "steps": [
        { "type": "configure", "name": "desktop" },
        { "type": "build", "name": "desktop" },
        { "type": "test", "name": "desktop" }
      ]
    },
    {
      "name": "full",
      "steps": [
        { "type": "configure", "name": "full" },
        { "type": "build", "name": "full" },
        { "type": "test", "name": "full" }
      ]
    }
  ]
}
